# NovelCast Environment Configuration Example
# Copy this file to .env and replace with your actual keys

# Supabase Authentication & Database
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Fish Audio API Key for Text-to-Speech / Audio Novel narration
Fish_Audio=your_fish_audio_api_key_here

# Figma Personal Access Token and File Key for design inspection & assets
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token
FIGMA_FILE_KEY=0WW7OwtWFVtYtIXQGuPdk2

# Google Stitch AI / Cloud API Key
GOOGLE_API_KEY=your_google_api_key_here

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/novelcast?retryWrites=true&w=majority

# Backend API port (default 4000)
# PORT=4000

# Comma-separated CORS allow-list, or * for any origin
# CORS_ORIGIN=*

# Resolvers used only if the machine's own DNS refuses the SRV lookup that
# mongodb+srv:// requires (VPN clients and local DNS stubs commonly do).
# Set to an empty string to disable the fallback.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
